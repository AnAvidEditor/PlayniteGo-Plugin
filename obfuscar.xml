<?xml version="1.0" encoding="utf-8" ?>
<Obfuscator>
	<Var name="InPath" value=".\bin\Release" />
	<Var name="OutPath" value=".\bin\Release\obfuscated" />

	<Var name="KeepPublicApi" value="true" />
	<Var name="HidePrivateApi" value="true" />

	<Module file="$(InPath)\PlayniteGo.dll">
		<Type name="PlayniteGo.PlayniteGo" skip="Rename" />
		<Type name="PlayniteGo.PlayniteGoSettingsViewModel" skip="Rename" />
		<Type name="PlayniteGo.PlayniteGoSettings" skip="Rename" />
		<Type name="PlayniteGo.PlayniteGoSettingsView" skip="Rename" />

		<Type name="PlayniteGo\.(HltbApi\..*|.*(Payload|Export|Stats|Options|Data|Score|Time|LinkExport))$" skip="Rename">
			<Property name=".*" skip="Rename" />
		</Type>
	</Module>
</Obfuscator>