<?xml version="1.0" encoding="utf-8" ?>
<Obfuscator>
	<Var name="InPath" value=".\bin\Release" />
	<Var name="OutPath" value=".\bin\Release\obfuscated" />

	<Var name="KeepPublicApi" value="true" />
	<Var name="HidePrivateApi" value="true" />

	<Module file="$(InPath)\PlayniteGo.dll">
		<Type name="PlayniteGo.PlayniteGo" skip="Rename" />

		<Type name="PlayniteGo.PlayniteGoSettingsViewModel" skip="Rename" />
		<Type name="PlayniteGo.PlayniteGoSettings" skip="Rename" />
		<Type name="PlayniteGo.PlayniteGoSettingsView" skip="Rename" />

		<Type name="PlayniteGo.HltbApi.*" skip="Rename" />
		<Type name="PlayniteGo.ExportPayload" skip="Rename" />
		<Type name="PlayniteGo.GameExport" skip="Rename" />
		<Type name="PlayniteGo.ExportedStats" skip="Rename" />
		<Type name="PlayniteGo.SummaryStats" skip="Rename" />
		<Type name="PlayniteGo.BacklogStats" skip="Rename" />
		<Type name="PlayniteGo.ExportedFilterOptions" skip="Rename" />
		<Type name="PlayniteGo.TimeData" skip="Rename" />
		<Type name="PlayniteGo.RangeData" skip="Rename" />
		<Type name="PlayniteGo.CountData" skip="Rename" />
		<Type name="PlayniteGo.GameScore" skip="Rename" />
		<Type name="PlayniteGo.GameTime" skip="Rename" />
		<Type name="PlayniteGo.LinkExport" skip="Rename" />
	</Module>
</Obfuscator>